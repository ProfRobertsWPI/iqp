---
layout: null
---
[
{%- assign guide_pages = site.pages | where: "layout", "default" | sort: "url" -%}
{%- for guide_page in guide_pages %}
  {
    "title": {{ guide_page.title | jsonify }},
    "url": {{ guide_page.url | relative_url | jsonify }},
    "text": {{ guide_page.content | markdownify | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
